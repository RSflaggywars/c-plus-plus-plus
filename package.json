{
  "name": "c-plus-plus-plus",
  "displayName": "c+++",
  "description": "A simpler C++-like language that compiles and runs automatically in VS Code",
  "version": "0.1.4",
  "publisher": "c-plus-plus-plus",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "activationEvents": [
    "onLanguage:c+++"
  ],
  "main": "./out/extension.js",
  "bin": {
    "cppp": "./bin/cppp.js"
  },
  "contributes": {
    "languages": [
      {
        "id": "c+++",
        "aliases": [
          "C+++",
          "cppplus"
        ],
        "extensions": [
          ".c+++",
          ".cppp"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [],
    "iconThemes": [
      {
        "id": "cppplus-icons",
        "label": "c+++ Icons (Seti + c+++)",
        "path": "./icons/cppplus-icon-theme.json"
      }
    ],
    "commands": [
      {
        "command": "cplus.runFile",
        "title": "c+++: Run File"
      },
      {
        "command": "cplus.compileFile",
        "title": "c+++: Compile (show JS output)"
      }
    ],
    "debuggers": [
      {
        "type": "cppplus",
        "label": "c+++ Runner",
        "program": "./out/debugAdapter.js",
        "runtime": "node",
        "languages": [
          "c+++"
        ],
        "configurationAttributes": {
          "launch": {
            "required": [
              "program"
            ],
            "properties": {
              "program": {
                "type": "string",
                "description": "Path to the .c+++ file to run"
              },
              "stopOnEntry": {
                "type": "boolean",
                "default": false
              }
            }
          }
        },
        "initialConfigurations": [
          {
            "type": "cppplus",
            "request": "launch",
            "name": "Run c+++ file",
            "program": "${file}"
          }
        ],
        "configurationSnippets": [
          {
            "label": "c+++ launch",
            "description": "Run a c+++ file",
            "body": {
              "type": "cppplus",
              "request": "launch",
              "name": "Run ${fileBasename}",
              "program": "${file}"
            }
          }
        ]
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "vscode:prepublish": "npm run compile"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.4.0"
  }
}
